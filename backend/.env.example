# ================================
# ENTORNO GENERAL
# ================================
# Puerto en el que se ejecuta el servidor
PORT=3000

# Entorno: development | production
NODE_ENV=production

# ================================
# BASE DE DATOS
# ================================
# URL de conexión a PostgreSQL (formato: postgresql://usuario:contraseña@host:puerto/nombre_db)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/crowdpass

# Habilitar SSL para conexiones a la BD (recomendado para producción)
DB_SSL=true

# Tamaño máximo del pool de conexiones
DB_POOL_MAX=20

# Tiempo máximo de inactividad de una conexión en el pool (ms)
DB_POOL_IDLE_TIMEOUT_MS=10000

# Tiempo máximo de espera para obtener una conexión (ms)
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ================================
# JWT (Autenticación)
# ================================
# Secreto para firmar tokens JWT (CAMBIAR POR UN VALOR SEGURO EN PRODUCCIÓN!)
JWT_SECRET=change_this_to_a_very_secure_random_string_in_production

# Tiempo de expiración de los tokens JWT
JWT_EXPIRES_IN=1h

# ================================
# APLICACIÓN
# ================================
# Email del administrador bootstrap (opcional)
BOOTSTRAP_ADMIN_EMAIL=admin@crowdpass.com

# API key de Pexels para imágenes (opcional)
PEXELS_API_KEY=your_pexels_api_key_here

# ================================
# RATE LIMITING
# ================================
# Máximo de peticiones globales por ventana
GLOBAL_RATE_LIMIT_MAX=200

# Máximo de peticiones de autenticación por ventana
AUTH_RATE_LIMIT_MAX=20

# Máximo de peticiones de disponibilidad por ventana
AVAILABILITY_RATE_LIMIT_MAX=60

# Duración de la ventana de rate limiting (ms, default: 15 minutos)
RATE_LIMIT_WINDOW_MS=900000

# ================================
# RESERVAS
# ================================
# Tiempo de expiración de reservas pendientes de pago (minutos)
RESERVATION_PENDING_TTL_MINUTES=15

# ================================
# CORS
# ================================
# Orígenes permitidos para CORS (separados por coma)
# Incluir la URL del frontend en producción
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-app.vercel.app
SUPERADMIN_EMAILS=
